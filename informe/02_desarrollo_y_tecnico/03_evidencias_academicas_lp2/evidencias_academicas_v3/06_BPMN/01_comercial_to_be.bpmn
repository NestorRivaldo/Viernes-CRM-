        <dc:Bounds x="200" y="1760" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Cierre" bpmnElement="Cierre" isHorizontal="false">
        <dc:Bounds x="775" y="1920" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Fin" bpmnElement="Fin" isHorizontal="false">
        <dc:Bounds x="880" y="2080" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_MensajeNecesidad" bpmnElement="MensajeNecesidad">
        <di:waypoint x="218" y="75" />
        <di:waypoint x="218" y="125" />
      </bpmndi:BPMNEdge>
