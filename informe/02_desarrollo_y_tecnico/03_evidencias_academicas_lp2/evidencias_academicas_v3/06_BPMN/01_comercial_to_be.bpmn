<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Comercial" targetNamespace="https://viernes.local/documentacion" exporter="Evidencias Viernes" exporterVersion="3">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="ClienteExterno" name="Cliente potencial — comunicación externa al CRM" />
    <bpmn:participant id="Equipo" name="Equipo comercial / Viernes CRM" processRef="ProcesoComercial" />
    <bpmn:messageFlow id="MensajeNecesidad" name="Necesidad (canal externo)" sourceRef="ClienteExterno" targetRef="Inicio" />
  </bpmn:collaboration>
  <bpmn:process id="ProcesoComercial" name="TO-BE comercial — registro humano y apoyo CRM" isExecutable="false">
    <bpmn:documentation>Modelo analítico, no workflow ejecutable. Los registros y decisiones de negocio no implican que exista automatización o comunicación externa implementada. Lead CONVERTIDO solo cambia estado.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Vendedor" name="Vendedor / usuario">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Viable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Envio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinCanc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="CRM" name="CRM — apoyo del sistema">
        <bpmn:flowNodeRef>Descartar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinDesc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinBorrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EstadoEnviada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancelar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Jefe" name="JEFE / ADMIN">
        <bpmn:flowNodeRef>Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Necesidad detectada">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageStart" />
    </bpmn:startEvent>
    <bpmn:userTask id="Lead" name="Registrar lead y fuente opcional">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Calificar" name="Contactar y evaluar lead; actualizar estado">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Viable" name="¿Continuar gestión?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Descartar" name="Guardar DESCARTADO solicitado por usuario">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinDesc" name="Gestión descartada">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Registrar" name="Registrar/seleccionar cliente y oportunidad por acción del usuario">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Preparar" name="Preparar propuesta y al menos un detalle">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Validar" name="Validar DTO, referencias, fechas y detalle">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valido" name="¿Solicitud válida?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Error" name="Corregir datos y reenviar solicitud">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Guardar" name="Numerar, calcular y guardar BORRADOR">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Enviar" name="Solicitar enviar BORRADOR (o conservarlo)">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Envio" name="¿Enviar ahora?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FinBorrador" name="Borrador conservado">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="EstadoEnviada" name="Validar BORRADOR; guardar ENVIADA">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Revisar" name="Revisar propuesta y elegir decisión">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="¿Decisión?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Aprobar" name="Solicitar aprobar ENVIADA; API guarda APROBADA">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Rechazar" name="Rechazar: exigir ENVIADA; guardar RECHAZADA">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Cancelar" name="Cancelar: exigir estado no terminal; guardar CANCELADA">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FinRechazo" name="Propuesta rechazada">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FinCanc" name="Propuesta cancelada">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Cierre" name="Actualizar oportunidad por decisión comercial independiente">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Fin" name="Gestión documentada">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Inicio" targetRef="Lead" />
    <bpmn:sequenceFlow id="F2" sourceRef="Lead" targetRef="Calificar" />
    <bpmn:sequenceFlow id="F3" sourceRef="Calificar" targetRef="Viable" />
    <bpmn:sequenceFlow id="F4" sourceRef="Viable" targetRef="Descartar" name="No" />
    <bpmn:sequenceFlow id="F5" sourceRef="Descartar" targetRef="FinDesc" />
    <bpmn:sequenceFlow id="F6" sourceRef="Viable" targetRef="Registrar" name="Sí" />
    <bpmn:sequenceFlow id="F7" sourceRef="Registrar" targetRef="Preparar" />
    <bpmn:sequenceFlow id="F8" sourceRef="Preparar" targetRef="Validar" />
    <bpmn:sequenceFlow id="F9" sourceRef="Validar" targetRef="Valido" />
    <bpmn:sequenceFlow id="F10" sourceRef="Valido" targetRef="Error" name="No: 400/404" />
    <bpmn:sequenceFlow id="F11" sourceRef="Error" targetRef="Preparar" name="Corregir" />
    <bpmn:sequenceFlow id="F12" sourceRef="Valido" targetRef="Guardar" name="Sí" />
    <bpmn:sequenceFlow id="F13" sourceRef="Guardar" targetRef="Enviar" />
    <bpmn:sequenceFlow id="F14" sourceRef="Enviar" targetRef="Envio" />
    <bpmn:sequenceFlow id="F15" sourceRef="Envio" targetRef="FinBorrador" name="No" />
    <bpmn:sequenceFlow id="F16" sourceRef="Envio" targetRef="EstadoEnviada" name="Sí" />
    <bpmn:sequenceFlow id="F17" sourceRef="EstadoEnviada" targetRef="Revisar" />
    <bpmn:sequenceFlow id="F18" sourceRef="Revisar" targetRef="Decision" />
    <bpmn:sequenceFlow id="F19" sourceRef="Decision" targetRef="Aprobar" name="Aprobar" />
    <bpmn:sequenceFlow id="F20" sourceRef="Decision" targetRef="Rechazar" name="Rechazar" />
    <bpmn:sequenceFlow id="F21" sourceRef="Decision" targetRef="Cancelar" name="Cancelar" />
    <bpmn:sequenceFlow id="F22" sourceRef="Rechazar" targetRef="FinRechazo" />
    <bpmn:sequenceFlow id="F23" sourceRef="Cancelar" targetRef="FinCanc" />
    <bpmn:sequenceFlow id="F24" sourceRef="Aprobar" targetRef="Cierre" />
    <bpmn:sequenceFlow id="F25" sourceRef="Cierre" targetRef="Fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama">
    <bpmndi:BPMNPlane id="Plano" bpmnElement="Collab">
      <bpmndi:BPMNShape id="DI_ClienteExterno" bpmnElement="ClienteExterno" isHorizontal="false">
        <dc:Bounds x="40" y="10" width="1020" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Equipo" bpmnElement="Equipo" isHorizontal="false">
        <dc:Bounds x="5" y="85" width="1055" height="2110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Vendedor" bpmnElement="Vendedor" isHorizontal="false">
        <dc:Bounds x="40" y="85" width="340" height="2110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_CRM" bpmnElement="CRM" isHorizontal="false">
        <dc:Bounds x="380" y="85" width="340" height="2110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Jefe" bpmnElement="Jefe" isHorizontal="false">
        <dc:Bounds x="720" y="85" width="340" height="2110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Inicio" bpmnElement="Inicio" isHorizontal="false">
        <dc:Bounds x="200" y="125" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lead" bpmnElement="Lead" isHorizontal="false">
        <dc:Bounds x="95" y="225" width="245" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Calificar" bpmnElement="Calificar" isHorizontal="false">
        <dc:Bounds x="95" y="345" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Viable" bpmnElement="Viable" isHorizontal="false">
        <dc:Bounds x="190" y="490" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Descartar" bpmnElement="Descartar" isHorizontal="false">
        <dc:Bounds x="435" y="485" width="245" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_FinDesc" bpmnElement="FinDesc" isHorizontal="false">
        <dc:Bounds x="535" y="625" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Registrar" bpmnElement="Registrar" isHorizontal="false">
        <dc:Bounds x="95" y="625" width="245" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Preparar" bpmnElement="Preparar" isHorizontal="false">
        <dc:Bounds x="95" y="780" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Validar" bpmnElement="Validar" isHorizontal="false">
        <dc:Bounds x="435" y="780" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Valido" bpmnElement="Valido" isHorizontal="false">
        <dc:Bounds x="530" y="945" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Error" bpmnElement="Error" isHorizontal="false">
        <dc:Bounds x="95" y="950" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Guardar" bpmnElement="Guardar" isHorizontal="false">
        <dc:Bounds x="435" y="1115" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Enviar" bpmnElement="Enviar" isHorizontal="false">
        <dc:Bounds x="95" y="1115" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Envio" bpmnElement="Envio" isHorizontal="false">
        <dc:Bounds x="190" y="1270" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_FinBorrador" bpmnElement="FinBorrador" isHorizontal="false">
        <dc:Bounds x="535" y="1280" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_EstadoEnviada" bpmnElement="EstadoEnviada" isHorizontal="false">
        <dc:Bounds x="435" y="1420" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Revisar" bpmnElement="Revisar" isHorizontal="false">
        <dc:Bounds x="775" y="1420" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Decision" bpmnElement="Decision" isHorizontal="false">
        <dc:Bounds x="870" y="1585" width="55" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Aprobar" bpmnElement="Aprobar" isHorizontal="false">
        <dc:Bounds x="775" y="1740" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Rechazar" bpmnElement="Rechazar" isHorizontal="false">
        <dc:Bounds x="435" y="1590" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Cancelar" bpmnElement="Cancelar" isHorizontal="false">
        <dc:Bounds x="435" y="1740" width="245" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_FinRechazo" bpmnElement="FinRechazo" isHorizontal="false">
        <dc:Bounds x="200" y="1600" width="36" height="36" />
      </bpmndi:BPMNShape>
