        <di:waypoint x="680" y="1780.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F22" bpmnElement="F22">
        <di:waypoint x="435" y="1630.0" />
        <di:waypoint x="236" y="1618.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F23" bpmnElement="F23">
        <di:waypoint x="435" y="1780.0" />
        <di:waypoint x="236" y="1778.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F24" bpmnElement="F24">
